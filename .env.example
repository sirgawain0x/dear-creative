# Turso (libSQL) — use file: URL locally; hosted URL + token in production only
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Resend
RESEND_API_KEY=
RESEND_FROM=
# Set to exactly "true" to call Resend send APIs; otherwise newsletter delivery logs only.
RESEND_LIVE=false
RESEND_WEBHOOK_SECRET=

# Subscriber double opt-in / unsubscribe tokens (local secret; generate in dev)
SUBSCRIBER_TOKEN_SECRET=

# Public site origin for email links (local dev)
NEXT_PUBLIC_SITE_URL=

# X (OAuth 1.0a user context — Adam teaser delivery + oracle broadcast)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
# Preferred name for the access token secret:
X_ACCESS_TOKEN_SECRET=
# Legacy alias (still supported for oracle/social.ts deployments):
X_ACCESS_SECRET=
# Set to exactly "true" (case-sensitive) for live X posts (Adam delivery + oracle broadcast).
X_LIVE=false

# Mastodon Syndication
MASTODON_INSTANCE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# LinkedIn — G2 personal profile posting (OAuth + Posts API; default off)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Must match the redirect URL configured in the LinkedIn Developer app
LINKEDIN_REDIRECT_URI=
# 32-byte key, base64-encoded (server-only; encrypts stored OAuth tokens)
LINKEDIN_TOKEN_ENCRYPTION_KEY=
# At least 32 bytes, base64-encoded — HMAC for OAuth state (separate from encryption key)
LINKEDIN_STATE_SECRET=
# Posts API version header (YYYYMM); defaults to 202601 when unset
# LINKEDIN_API_VERSION=202601
# Set to exactly "true" to allow live posts via POST /rest/posts
LINKEDIN_POSTING_ENABLED=false

# Reality.eth Oracle (Base)
# Defaults to Base Mainnet: 0x446e545A6d0429718429B57c9135061413a2F44a
REALITY_ETH_ADDRESS=
CRON_SECRET=

# Payments (default off — USDC subscription rail on Base when enabled)
PAYMENTS_ENABLED=false
# Dear Creative 90/10 PullSplit validation (Base mainnet)
# DEAR_PLATFORM_TREASURY_ADDRESS=
# Coinbase CDP / x402 (agent per-post paywall; set when PAYMENTS_ENABLED=true)
# Leave CDP_API_KEY_* blank on Base Sepolia to use https://x402.org/facilitator;
# set CDP_API_KEY_ID and CDP_API_KEY_SECRET to auto-use Coinbase CDP Facilitator (https://api.cdp.coinbase.com/platform/v2/x402)
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
X402_PAY_TO_ADDRESS=
X402_MAX_AMOUNT_REQUIRED=
# Optional: "base-sepolia" (default) or "base" (Base Mainnet)
# X402_NETWORK=base-sepolia
# X402_FACILITATOR_URL=

# Privy
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_ADMIN_USER_IDS=

# Admin owner wallet (read-only UI/API on /admin; default off)
WALLET_ENABLED=false
# Admin wallet send (Base USDC via Privy embedded wallet; default off)
# WALLET_SEND_ENABLED=false
# Max USDC per send (default 100)
# WALLET_SEND_MAX_USDC=100
# Set true only when Privy gas sponsorship is enabled for embedded wallets in the dashboard
# PRIVY_EMBEDDED_GAS_SPONSORSHIP=false

# Admin wallet swap (Base ETH↔USDC via Alchemy Wallet APIs + EIP-7702; default off)
# WALLET_SWAP_ENABLED=false
# WALLET_SWAP_MAX_USDC=100
# Alchemy Gas Manager policy for swap gas sponsorship (server-only)
# ALCHEMY_SWAP_POLICY_ID=
# Checksummed Base address for balances, receive QR, and transfer history
ADMIN_WALLET_ADDRESS=

# Privy Earn (read-only admin UI/API; default off)
EARN_ENABLED=false
# Privy server wallet id for GET /api/admin/earn/position (never expose to client)
ADMIN_PRIVY_WALLET_ID=
# Alchemy key for server-side Base reads (never expose to the client)
# ALCHEMY_API_KEY=
# Dev-only: return fixture balances/history for UI screenshots (never in production)
# WALLET_READ_FIXTURE=true
# Dev-only: enable /admin/wallet-fixture/* on non-local hosts (never production)
# ADMIN_WALLET_FIXTURE=true

# Adam (Cloud Run) → web app API (Bearer token for /api/adam/*)
ADAM_API_TOKEN=
# Base URL of the deployed Dear Creative app (Cloud Run Adam service uses Secret Manager)
# DEAR_CREATIVE_API_BASE_URL=
# Google Gemini API key for Adam Studio multimodal chat, file/image analysis, and Google Voice (STT & TTS)
GEMINI_API_KEY=
# Optional model overrides (defaults: gemini-3.8-flash, gemini-3.8-flash-tts)
# ADAM_GEMINI_MODEL=gemini-3.8-flash
# ADAM_GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# Banner images via Interactions API (default: gemini-nano-banana-2.1)
# ADAM_IMAGEN_MODEL=gemini-nano-banana-2.1

# Public author profile pages at /authors/[id] (default off; must be exactly "true" to enable)
AUTHOR_PROFILES_ENABLED=false

# Repurpose panel (NotebookLM-style outputs in Studio edit-post view; default off)
REPURPOSE_ENABLED=false
# Pricing stub only — no billing logic in v1
REPURPOSE_PRICING=false
# Optional: gemini-nano-banana-2.1 (see ai.google.dev/gemini-api/docs/models)
# REPURPOSE_INFOGRAPHIC_MODEL=gemini-nano-banana-2.1

# Local dev default (file-backed libSQL). Override only for local/dev imports.
LOCAL_DATABASE_URL=file:./data/dear-creative.db

# CRTVAI Token & MeToken Bonding Curve (Base)
NEXT_PUBLIC_CRTVAI_ADDRESS=
NEXT_PUBLIC_METOKEN_ROUTER_ADDRESS=
NEXT_PUBLIC_METOKEN_DIAMOND_ADDRESS=
